# --- Скопируйте в .env и заполните. В репозиторий .env не коммитится (ОТ-03) ---
# PostgreSQL
POSTGRES_USER=kontur
POSTGRES_PASSWORD=kontur
POSTGRES_DB=kontur
POSTGRES_PORT=5432

# API
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHARS
JWT_LIFETIME_MINUTES=120

# Интеграции: true = работать на моках DataFactory (режим разработки/демо)
USE_MOCKS=true

# LLM для ассистента «Проявитель» (заполняет команда трека 3; провайдер OpenAI-совместимый)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
