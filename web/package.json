{
	"private": true,
	"version": "3.16.3",
	"scripts": {
		"start": "vite",
		"postinstall": "node scripts/ensure-zustand3.js",
		"build": "cross-env vite build",
		"preview": "vite preview",
		"test": "cross-env NODE_OPTIONS=--max_old_space_size=4096 jest",
		"e2e": "playwright test",
		"e2e-ui": "playwright test --ui",
		"coverage": "rimraf .nyc_output coverage && cross-env COVERAGE=true playwright test && jest --coverage && nyc report",
		"coverage:soft": "rimraf .nyc_output coverage && (cross-env COVERAGE=true playwright test || true) && (jest --coverage || true) && nyc report",
		"coverage:report": "nyc report",
		"lint": "eslint src --ext .js,.jsx,.ts,.tsx",
		"lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix ",
		"format": "prettier src --ext .js,.jsx,.ts,.tsx --write",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"typecheck:soft": "tsc -p tsconfig.json --noEmit || exit 0",
		"ts-coverage": "typescript-coverage-report --threshold=95",
		"bundle:analyze": "cross-env ANALYZER_MODE=server vite build --debug",
		"start:ui": "./bin/start-ui-lib.sh",
		"remove:ui": "./bin/remove-ui-lib.sh"
	},
	"engines": {
		"node": ">=24.11.0"
	},
	"eslintConfig": {
		"extends": [
			"react-app",
			"react-app/jest"
		]
	},
	"browserslist": [
		">0.2%",
		"not dead",
		"not op_mini all"
	],
	"lint-staged": {
		"**/*.{js,jsx,ts,tsx}": [
			"eslint --fix",
			"prettier --config ./.prettierrc.json --write"
		],
		"**/*.{css,scss,md,html,json}": [
			"prettier --config ./.prettierrc.json --write"
		]
	},
