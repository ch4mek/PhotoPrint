{
	"name": "@mms/mms-ui-library",
	"version": "5.2.2",
	"packageManager": "yarn@4.13.0",
	"scripts": {
		"rollup": "tsc --noEmit && rollup -c",
		"build:themes": "shx mkdir -p dist/themes .storybook/public/themes && postcss src/styles/shared/index.css -o dist/themes/shared.css && postcss src/styles/themes/mms/index.css -o dist/themes/mms.css && postcss src/styles/themes/mems/index.css -o dist/themes/mems.css && postcss src/styles/themes/mtms/index.css -o dist/themes/mtms.css && postcss src/styles/themes/asmt/index.css -o dist/themes/asmt.css && shx cp dist/themes/*.css .storybook/public/themes/",
		"build": "yarn rollup && yarn build:themes",
		"lint": "eslint src --ext .js,.jsx,.ts,.tsx",
		"lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
		"format": "prettier . --write",
		"test": "jest",
		"storybook": "storybook dev -p 6006",
		"prestorybook": "yarn build:themes",
		"build-storybook": "storybook build",
		"prebuild-storybook": "yarn build:themes",
		"test:ci": "playwright test",
		"test:update": "playwright test --update-snapshots",
		"storybook:preview": "npx http-server storybook-static --port 6006",
		"storybook:serve": "yarn build-storybook && yarn storybook:preview",
		"test:report": "playwright show-report",
		"docker:down": "docker compose down --rmi local --volumes --remove-orphans",
		"docker:build": "docker compose build storybook-screenshots",
		"docker:build:clean": "docker compose build --no-cache storybook-screenshots",
		"docker:run": "docker compose run --rm storybook-screenshots",
		"docker:run:update": "docker compose run --rm -e UPDATE_MODE=true storybook-screenshots",
		"docker:rebuild": "yarn docker:down && yarn docker:build",
		"docker:rebuild:clean": "yarn docker:down && yarn docker:build:clean",
		"test:docker": "yarn docker:run",
		"test:docker:clean": "yarn docker:rebuild && yarn docker:run",
		"test:docker:update": "yarn docker:run:update",
		"test:docker:update:clean": "yarn docker:rebuild:clean && yarn docker:run:update",
		"lint:css": "stylelint \"src/**/*.module.css\"",
		"lint:css:fix": "stylelint \"src/**/*.module.css\" --fix"
	},
