environments:
  dev:
    values:
      - envs/dev.yaml
  qa:
    values:
      - envs/qa.yaml
  stage:
    values:
      - envs/stage.yaml
  prod:
    values:
      - envs/prod.yaml
  dev-pp:
    values:
      - envs/people-force.yaml
---
releases:
  - name: {{ .Values.infrastructure_env }}-mms-{{ .Values.app_env }}
    chart: charts/portalapi
    version: 1.0.0
    namespace: {{ .Values.infrastructure_env }}-mms-{{ .Values.app_env }}
    installed: {{ .Values | get "apps.portalapi.installed" "true" }}
    values:
      - values/portalapi/values.yaml.gotmpl
  - name: {{ .Values.infrastructure_env }}-mms-postgresql
    chart: charts/postgresql-15.5.38.tgz
    version: 15.5.38
    namespace: {{ .Values.infrastructure_env }}-mms-{{ .Values.app_env }}
    installed: {{ .Values | get "apps.postgresql.installed" "true" }}
    values:
      - values/postgresql/values.yaml.gotmpl
  - name: {{ .Values.infrastructure_env }}-mms-redis
    chart: charts/redis-19.6.4.tgz
    version: 19.6.4
    namespace: {{ .Values.infrastructure_env }}-mms-{{ .Values.app_env }}
    installed: {{ .Values | get "apps.redis.installed" "true" }}
    values:
      - values/redis/values.yaml.gotmpl
  - name: {{ .Values.infrastructure_env }}-mms-rabbitmq
    chart: charts/rabbitmq-15.4.0.tgz
    version: 15.4.0
    namespace: {{ .Values.infrastructure_env }}-mms-{{ .Values.app_env }}
    installed: {{ .Values | get "apps.rabbitmq.installed" "true" }}
    values:
      - values/rabbitmq/values.yaml.gotmpl
  - name: "{{ .Values.infrastructure_env }}-postgresql-backup-{{ .Values.app_env }}"
    chart: charts/postgresql-backup-dev
    version: 1.0.0
    namespace: "{{ .Values.infrastructure_env }}-mms-{{ .Values.app_env }}"
    installed: {{ .Values | get "apps.postgresqlBackupDev.installed" "true" }}
    values:
      - values/postgresql-backup-dev/values.yaml.gotmpl
  - name: "{{ .Values.infrastructure_env }}-postgresql-backup-recruitment-{{ .Values.app_env }}"
    chart: charts/postgresql-backup-dev-recruitment
    version: 1.0.0
    namespace: "{{ .Values.infrastructure_env }}-mms-{{ .Values.app_env }}"
    installed: {{ .Values | get "apps.postgresqlBackupDevRecruitment.installed" "true" }}
    values:
      - values/postgresql-backup-dev-recruitment/values.yaml.gotmpl
